# Copy to `.env` and fill in. `.env` is git-ignored; this file is not, so
# never put a real secret here.
#
# Every variable is prefixed FA_. Anything not set falls back to the default
# in backend/app/core/config.py, except the two secrets below, which have no
# usable default by design — the settings validator refuses to start in
# production while the placeholder is still in place.

# --- environment ------------------------------------------------------------
# local | test | staging | production
# `production` additionally requires a real secret key and a non-SQLite
# database, and hides /docs and /openapi.json.
FA_ENVIRONMENT=local

# --- secrets ----------------------------------------------------------------
# Signs session and download tokens. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every session immediately, which is the intended
# way to sign everyone out.
FA_SECRET_KEY=

# Postgres password, used by docker-compose for both the database and the
# app's connection string.
FA_DB_PASSWORD=

# --- database ---------------------------------------------------------------
# SQLite by default so the app runs with no services at all. PostgreSQL is
# the deployment target and is required when FA_ENVIRONMENT=production.
#   FA_DATABASE_URL=postgresql+psycopg://schedulefa:PASSWORD@localhost:5432/schedulefa
# FA_DATABASE_URL=

# Echoes every SQL statement. Noisy; useful once.
FA_DATABASE_ECHO=false

# --- storage ----------------------------------------------------------------
# Uploaded statements and generated workpapers, stored content-addressed.
# This is the directory to back up.
# FA_STORAGE_ROOT=./var/storage

# Refused above this size, before the body is read into memory.
FA_MAX_UPLOAD_BYTES=26214400

# --- reference data ---------------------------------------------------------
# Holds fx/ (SBI rate datasets) and market/ (daily price CSVs). Mounted
# read-only in Docker: the app resolves rates from here and must never be
# able to rewrite one.
# FA_DATA_ROOT=./data

# --- tokens -----------------------------------------------------------------
FA_ACCESS_TOKEN_TTL_SECONDS=3600
# Download links are deliberately short-lived: the credential travels in the
# URL, so it is visible in browser history and proxy logs.
FA_DOWNLOAD_URL_TTL_SECONDS=300

# --- jobs -------------------------------------------------------------------
# inline = run the calculation inside the request (simple, blocks the caller)
# thread = run it in a background thread and return a run id to poll
FA_JOB_BACKEND=inline

# --- frontend ---------------------------------------------------------------
# Served from this process, same origin as the API. Set false to serve the
# API alone.
FA_SERVE_FRONTEND=true

# --- outbound network -------------------------------------------------------
# Off by default: no user-triggered calculation may ever cause a live fetch.
# Turn on only for an operator-initiated dataset import.
FA_ALLOW_OUTBOUND_INGESTION=false
